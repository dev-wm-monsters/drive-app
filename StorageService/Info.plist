<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DriveAppStorageService Info.plist. Embedded in the Mach-O (__TEXT,__info_plist) with
  CREATE_INFOPLIST_SECTION_IN_BINARY = YES, so codesign uses CFBundleIdentifier as the signing
  identifier ($(APP_BUNDLE_ID).storageservice) and Bundle.main can read the DriveApp* keys.
  G0-VERIFY: `codesign -dv Contents/MacOS/DriveAppStorageService` shows
  Identifier=$(APP_BUNDLE_ID).storageservice and the expanded DriveApp* values.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DriveAppStorageMachService</key>
	<string>$(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID).storage</string>
	<key>DriveAppTeamID</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>DriveAppBaseBundleID</key>
	<string>$(APP_BUNDLE_ID)</string>
</dict>
</plist>
