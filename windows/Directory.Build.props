<Project>
  <!-- Shared settings for every project under windows/. Version is overridable: dotnet build -p:Version=1.2.3 -->
  <PropertyGroup>
    <Version>0.0.1</Version>
    <Company>WakeupMonster</Company>
    <Product>DriveApp</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage source-gen is not worth it for a tray app that logs a few lines a minute. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Lets the Windows-only projects build on Linux/macOS CI (no native code runs). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
</Project>
