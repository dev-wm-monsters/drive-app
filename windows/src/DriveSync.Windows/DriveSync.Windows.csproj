<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only: Cloud Files API (cfapi) interop, sync-root registration, DPAPI token store. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DriveSync.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source generator: P/Invokes + structs from Microsoft's Win32 metadata (exact cfapi.h layouts). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DriveSync.Core\DriveSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DriveSync.App" />
  </ItemGroup>
</Project>
