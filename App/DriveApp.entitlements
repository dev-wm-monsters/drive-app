<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DriveApp (menu-bar host app) entitlements.
  - App Sandbox.
  - App Group $(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID): shared with the File
    Provider extension (UserDefaults suite, item index, and the keychain
    access group used by KeychainTokenStore).
  - network.client: Google OAuth + Drive API (sign-in, root lookup, uploads).
  - files.user-selected.read-only: read files picked in "Upload Files…".
  No hardened-runtime exceptions (com.apple.security.cs.*).
  No keychain-access-groups: the App Group doubles as the keychain access
  group (VERIFY-ON-MAC, see App/Shared/KeychainTokenStore.swift).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID)</string>
	</array>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
