<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DriveAppFS (FSKit module) entitlements.
  - com.apple.developer.fskit.fsmodule: required for an FSKit module
    (https://developer.apple.com/documentation/bundleresources/entitlements/com.apple.developer.fskit.fsmodule).
    Needs a provisioning profile from a real team; fskitd rejects unsigned or ad-hoc modules.
  - App Sandbox: mandatory for ExtensionKit extensions.
  - App Group: the StorageService Mach name is prefixed by this group, which is what allows the
    sandboxed extension to look it up (G0-VERIFY, see StorageService/main.swift).
  No network entitlement: the extension never talks to the network, only to StorageService.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.fskit.fsmodule</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
