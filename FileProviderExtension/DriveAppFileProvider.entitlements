<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DriveAppFileProvider (File Provider extension) entitlements.
  - App Sandbox (required for app extensions).
  - App Group $(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID): same group as the app
    (shared state, item index, keychain access group for the OAuth tokens).
  - network.client: Drive API (listing, changes, downloads, uploads).
  No hardened-runtime exceptions (com.apple.security.cs.*).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(APP_BUNDLE_ID)</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
